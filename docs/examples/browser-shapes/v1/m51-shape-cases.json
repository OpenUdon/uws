      "expected_literal": "{{literal}}"
    },
    {
      "name": "conditional-registration-slot",
      "profile_version": "uws.browser-registration.1.2",
      "slot": {
        "name": "contact",
        "required": false,
        "schema": {
          "type": "string"
        },
        "condition": {
          "slot": "country",
          "equals": "fixture-country"
        }
      },
      "preserve_full_native_condition_and_schema": true
    },
    {
      "name": "schema-valid-not-runtime-supported",
      "profile_version": "uws.browser.1.10",
      "output_mode": "text",
      "expected_schema_known": true,
      "expected_runtime_supported": false
    },
    {
      "name": "default-port-canonical",
      "origins": [
        "http://example.test",
        "https://example.test"
      ],
      "reject_noncanonical": [
        "http://example.test:80",
        "https://example.test:443"
      ]
    },
    {
      "name": "action-schema-extensions",
      "profile_version": "uws.browser.1.9",
      "parameters_schema": {
        "type": "object",
        "properties": {
          "example": {
            "type": "string",
            "default": "",
            "x-fixture-extension": {
              "zero": 0,
              "flag": false
            }
          }
        }
      },
      "preserve_complete_schema": true
    }
  ]
