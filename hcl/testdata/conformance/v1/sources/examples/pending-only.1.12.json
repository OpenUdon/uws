              },
              "required": ["filter"],
              "x-openudon-contract": "v1"
            },
            "outputs": {
              "type": "object",
              "properties": {
                "projects": { "type": "array" }
              },
              "required": ["projects"]
            },
            "effect": "read"
          }
        }
      ]
    }
  ]
