{
    "$id": "https://github.com/OpenUdon/uws/versions/ansible.1.0.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "UWS Ansible Module Source Profile 1.0",
    "description": "Wire schema for inert collection argspec source documents referenced from UWS 1.6 sourceDescriptions[].type = ansible-module. The document is a normalized form of the ansible-doc --json argument-spec output. UWS core does not duplicate this schema; source-aware conversion and review tooling validates argspec documents against it.",
    "type": "object",
    "required": [
        "argspec",
        "collection",
        "modules"
    ],
    "properties": {
        "argspec": {
            "description": "Profile identifier. MUST be the literal uws.ansible.1.0.",
            "type": "string",
            "const": "uws.ansible.1.0"
        },
        "collection": {
            "description": "The collection namespace this document describes, e.g. ansible.builtin or community.postgresql.",
            "type": "string",
            "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+$"
        },
        "info": {
            "$ref": "#/$defs/document-info"
        },
        "modules": {
            "description": "Module entries keyed by fully qualified collection name (FQCN). Each key is the value a UWS operation uses as sourceOperationId; the preferred sourceOperationRef form is #/modules/<fqcn>.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/module"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "document-info": {
            "type": "object",
            "properties": {
                "title": {
                    "type": "string"
                },
                "collectionVersion": {
                    "description": "Version of the collection the argspecs were extracted from.",
                    "type": "string"
                },
                "extractedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "source": {
                    "description": "How the document was produced, e.g. ansible-doc --json.",
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "parameter-type": {
            "description": "Ansible argument-spec value types.",
            "type": "string",
            "enum": [
                "str",
                "bool",
                "int",
                "float",
                "list",
                "dict",
                "path",
                "raw",
                "jsonarg",
                "json",
                "bytes",
                "sig"
            ]
        },
        "module": {
            "type": "object",
            "required": [
                "parameters"
            ],
            "properties": {
                "shortDescription": {
                    "type": "string"
                },
                "description": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "parameters": {
                    "description": "Module parameters keyed by parameter name. UWS request.body values bind against these names.",
                    "type": "object",
                    "propertyNames": {
                        "pattern": "^[a-z0-9_]+$"
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/parameter"
                    }
                },
                "returns": {
                    "description": "Documented return values keyed by name. UWS outputs reference these through $response.body.<name>. The conventional changed, failed, and msg keys are implied for every module and need not be declared.",
                    "type": "object",
                    "propertyNames": {
                        "pattern": "^[a-z0-9_]+$"
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/return-value"
                    }
                }
            },
            "additionalProperties": false
        },
        "parameter": {
            "type": "object",
            "properties": {
                "type": {
                    "$ref": "#/$defs/parameter-type"
                },
                "required": {
                    "type": "boolean"
                },
                "default": {},
                "choices": {
                    "type": "array",
                    "minItems": 1
                },
                "elements": {
                    "$ref": "#/$defs/parameter-type"
                },
                "aliases": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "description": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "noLog": {
                    "description": "True when the parameter value is sensitive and must never be logged or embedded in workflow documents; values for noLog parameters MUST be symbolic credential bindings.",
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "return-value": {
            "type": "object",
            "properties": {
                "description": {
                    "oneOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    ]
                },
                "type": {
                    "$ref": "#/$defs/parameter-type"
                },
                "returned": {
                    "description": "When the value is returned, e.g. always, success, changed.",
                    "type": "string"
                },
                "sample": {}
            },
            "additionalProperties": false
        }
    }
}
