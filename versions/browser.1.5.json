{
    "$id": "https://github.com/OpenUdon/uws/versions/browser.1.5.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "UWS Browser Capability Profile 1.5",
    "description": "Wire schema for the browser-profile source description sub-spec referenced from UWS 1.5 sourceDescriptions[].type = browser-profile. UWS core does not duplicate this schema; browser-aware tooling and runtimes validate profile documents against it.",
    "type": "object",
    "required": [
        "profile",
        "info",
        "observationKind",
        "evidence",
        "confidence",
        "expiresAfter",
        "verification",
        "actions"
    ],
    "properties": {
        "profile": {
            "description": "Profile identifier. MUST be the literal uws.browser.1.5.",
            "type": "string",
            "const": "uws.browser.1.5"
        },
        "info": {
            "$ref": "#/$defs/profile-info"
        },
        "observationKind": {
            "$ref": "#/$defs/observation-kind"
        },
        "evidence": {
            "$ref": "#/$defs/evidence-block"
        },
        "confidence": {
            "$ref": "#/$defs/confidence-level"
        },
        "expiresAfter": {
            "description": "ISO-8601 duration after which the profile must be revalidated (e.g. P30D, P14D).",
            "type": "string",
            "allOf": [
                {
                    "pattern": "^P(?:\\d+Y)?(?:\\d+M)?(?:\\d+W)?(?:\\d+D)?(?:T(?:\\d+H)?(?:\\d+M)?(?:\\d+S)?)?$"
                },
                {
                    "pattern": "\\d+(?:Y|M|W|D|H|S)"
                }
            ]
        },
        "verification": {
            "$ref": "#/$defs/verification-block"
        },
        "actions": {
            "description": "Named reusable UI capabilities exposed by the profile. Each key is the action name addressed by sourceOperationId from the UWS workflow.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "pattern": "^[A-Za-z0-9_-]+$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/action"
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "profile-info": {
            "type": "object",
            "required": [
                "title",
                "origin"
            ],
            "properties": {
                "title": {
                    "type": "string"
                },
                "provider": {
                    "type": "string"
                },
                "origin": {
                    "description": "Browser origin allowlist. Runtimes MUST reject navigate instructions targeting domains outside this allowlist. May be a single origin string or an array of origins.",
                    "oneOf": [
                        {
                            "type": "string",
                            "format": "uri"
                        },
                        {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                                "type": "string",
                                "format": "uri"
                            }
                        }
                    ]
                },
                "loginStateRequired": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "observation-kind": {
            "description": "How the profile was learned. Recorded for review; the snapshot format itself stays runtime-owned.",
            "type": "string",
            "enum": [
                "accessibility_snapshot",
                "dom_text",
                "screenshot_ocr",
                "other"
            ]
        },
        "evidence-block": {
            "type": "object",
            "required": [
                "learnedAt"
            ],
            "properties": {
                "learnedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "source": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "confidence-level": {
            "type": "string",
            "enum": [
                "low",
                "medium",
                "high"
            ]
        },
        "verification-block": {
            "type": "object",
            "required": [
                "lastVerifiedAt",
                "successfulRuns"
            ],
            "properties": {
                "lastVerifiedAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "successfulRuns": {
                    "type": "integer",
                    "minimum": 0
                },
                "uiStabilityScore": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                }
            },
            "additionalProperties": false
        },
        "locator": {
            "description": "Accessibility-only locator. CSS selectors, XPath, DOM-structure paths, and pixel/coordinate references are NOT permitted.",
            "type": "object",
            "required": [
                "role"
            ],
            "properties": {
                "role": {
                    "type": "string",
                    "enum": [
                        "button",
                        "link",
                        "textbox",
                        "checkbox",
                        "radio",
                        "dialog",
                        "status",
                        "alert"
                    ]
                },
                "name": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "wait-for-condition": {
            "description": "Halt until a locator condition or navigation event fires.",
            "oneOf": [
                {
                    "$ref": "#/$defs/locator"
                },
                {
                    "type": "object",
                    "required": [
                        "navigation"
                    ],
                    "properties": {
                        "navigation": {
                            "type": "string",
                            "enum": [
                                "load",
                                "domcontentloaded",
                                "network_idle"
                            ]
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "step": {
            "description": "Closed declarative macro vocabulary. Exactly one of the following step keys MUST be set.",
            "type": "object",
            "oneOf": [
                {
                    "required": [
                        "navigate"
                    ],
                    "properties": {
                        "navigate": {
                            "description": "Relative or absolute URL redirection. Must be templatable from action parameters.",
                            "type": "string"
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "required": [
                        "click"
                    ],
                    "properties": {
                        "click": {
                            "type": "object",
                            "required": [
                                "locator"
                            ],
                            "properties": {
                                "locator": {
                                    "$ref": "#/$defs/locator"
                                },
                                "wait_for": {
                                    "$ref": "#/$defs/wait-for-condition"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "required": [
                        "type_text"
                    ],
                    "properties": {
                        "type_text": {
                            "type": "object",
                            "required": [
                                "locator",
                                "value"
                            ],
                            "properties": {
                                "locator": {
                                    "$ref": "#/$defs/locator"
                                },
                                "value": {
                                    "type": "string"
                                },
                                "wait_for": {
                                    "$ref": "#/$defs/wait-for-condition"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "required": [
                        "check_radio"
                    ],
                    "properties": {
                        "check_radio": {
                            "type": "object",
                            "required": [
                                "locator"
                            ],
                            "properties": {
                                "locator": {
                                    "$ref": "#/$defs/locator"
                                },
                                "wait_for": {
                                    "$ref": "#/$defs/wait-for-condition"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "required": [
                        "uncheck"
                    ],
                    "properties": {
                        "uncheck": {
                            "type": "object",
                            "required": [
                                "locator"
                            ],
                            "properties": {
                                "locator": {
                                    "$ref": "#/$defs/locator"
                                },
                                "wait_for": {
                                    "$ref": "#/$defs/wait-for-condition"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "required": [
                        "select_option"
                    ],
                    "properties": {
                        "select_option": {
                            "type": "object",
                            "required": [
                                "locator",
                                "value"
                            ],
                            "properties": {
                                "locator": {
                                    "$ref": "#/$defs/locator"
                                },
                                "value": {
                                    "type": "string"
                                },
                                "wait_for": {
                                    "$ref": "#/$defs/wait-for-condition"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                {
                    "required": [
                        "wait_for"
                    ],
                    "properties": {
                        "wait_for": {
                            "$ref": "#/$defs/wait-for-condition"
                        }
                    },
                    "additionalProperties": false
                }
            ]
        },
        "output": {
            "description": "Output extraction declaration. Primary methods are a11y or jsonld/microdata. CSS is permitted only as a last-resort fallback with a recorded fallbackReason and a typed validation schema.",
            "type": "object",
            "required": [
                "type",
                "source"
            ],
            "properties": {
                "type": {
                    "type": "string"
                },
                "source": {
                    "type": "string",
                    "enum": [
                        "a11y",
                        "jsonld",
                        "microdata",
                        "css"
                    ]
                },
                "locator": {
                    "$ref": "#/$defs/locator"
                },
                "selector": {
                    "description": "CSS selector. Permitted only when source=css.",
                    "type": "string"
                },
                "fallbackReason": {
                    "description": "Required when source=css; explains why a11y/jsonld/microdata are insufficient.",
                    "type": "string",
                    "enum": [
                        "no_a11y_region",
                        "no_structured_data",
                        "ambiguous_a11y",
                        "other"
                    ]
                },
                "validation": {
                    "description": "Inline JSON Schema for the extracted value.",
                    "type": "object"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "source": {
                                "const": "css"
                            }
                        },
                        "required": [
                            "source"
                        ]
                    },
                    "then": {
                        "required": [
                            "selector",
                            "fallbackReason",
                            "validation"
                        ],
                        "not": {
                            "required": [
                                "locator"
                            ]
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "source": {
                                "enum": [
                                    "a11y"
                                ]
                            }
                        },
                        "required": [
                            "source"
                        ]
                    },
                    "then": {
                        "required": [
                            "locator"
                        ],
                        "not": {
                            "anyOf": [
                                {
                                    "required": [
                                        "selector"
                                    ]
                                },
                                {
                                    "required": [
                                        "fallbackReason"
                                    ]
                                }
                            ]
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "source": {
                                "enum": [
                                    "jsonld",
                                    "microdata"
                                ]
                            }
                        },
                        "required": [
                            "source"
                        ]
                    },
                    "then": {
                        "not": {
                            "anyOf": [
                                {
                                    "required": [
                                        "locator"
                                    ]
                                },
                                {
                                    "required": [
                                        "selector"
                                    ]
                                },
                                {
                                    "required": [
                                        "fallbackReason"
                                    ]
                                }
                            ]
                        }
                    }
                }
            ],
            "additionalProperties": false
        },
        "side-effect": {
            "type": "string",
            "enum": [
                "read_only",
                "state_change",
                "sends_email",
                "creates_record",
                "updates_record",
                "deletes_resource"
            ]
        },
        "confirmation-policy": {
            "type": "object",
            "required": [
                "required"
            ],
            "properties": {
                "required": {
                    "type": "boolean"
                },
                "prompt": {
                    "type": "string"
                }
            },
            "additionalProperties": false
        },
        "action": {
            "type": "object",
            "required": [
                "sequence",
                "sideEffects",
                "confirmationPolicy"
            ],
            "properties": {
                "description": {
                    "type": "string"
                },
                "parameters": {
                    "description": "Inline JSON Schema for the action's templatable parameters. Sequence steps may reference these via {{paramName}} placeholders.",
                    "type": "object"
                },
                "sequence": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/step"
                    }
                },
                "outputs": {
                    "type": "object",
                    "propertyNames": {
                        "pattern": "^[A-Za-z0-9_-]+$"
                    },
                    "additionalProperties": {
                        "$ref": "#/$defs/output"
                    }
                },
                "sideEffects": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                        "$ref": "#/$defs/side-effect"
                    }
                },
                "confirmationPolicy": {
                    "$ref": "#/$defs/confirmation-policy"
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "sideEffects": {
                                "contains": {
                                    "const": "read_only"
                                }
                            }
                        },
                        "required": [
                            "sideEffects"
                        ]
                    },
                    "then": {
                        "properties": {
                            "sideEffects": {
                                "maxItems": 1
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "sideEffects": {
                                "contains": {
                                    "not": {
                                        "const": "read_only"
                                    }
                                }
                            }
                        },
                        "required": [
                            "sideEffects"
                        ]
                    },
                    "then": {
                        "properties": {
                            "confirmationPolicy": {
                                "properties": {
                                    "required": {
                                        "const": true
                                    }
                                },
                                "required": [
                                    "required"
                                ]
                            }
                        }
                    }
                }
            ],
            "additionalProperties": false
        }
    }
}
