{
  "$id": "https://github.com/OpenUdon/uws/versions/ansible-module-call.1.0.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UWS Ansible Module Call Supplement 1.0",
  "description": "Wire metadata schema for extension-owned Ansible module leaf operations. This supplement is the supported representation for Ansible module calls at every UWS version.",
  "type": "object",
  "required": [
    "x-uws-ansible-module"
  ],
  "properties": {
    "x-uws-ansible-module": {
      "$ref": "#/$defs/operation-ansible-module"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "operation-ansible-module": {
      "type": "object",
      "required": [
        "module"
      ],
      "properties": {
        "module": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9_]+\\.[a-z0-9_]+\\.[a-z0-9_]+$",
          "description": "Ansible module fully qualified collection name (exactly namespace.collection.module, lowercase per Ansible Galaxy naming rules), such as ansible.builtin.apt. Matches the module-key pattern in the uws.ansible.1.0 argspec schema."
        },
        "argspec": {
          "$ref": "#/$defs/argspec-reference"
        }
      },
      "additionalProperties": false
    },
    "argspec-reference": {
      "type": "object",
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "collection": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  }
}
